{% extends 'base.html.twig' %}

{% block title %}Lägg till bok{% endblock %}

{% block body %}
    <h1>Lägg till ny bok</h1>

    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.author) }}
        {{ form_row(form.isbn) }}
        {{ form_row(form.description) }}
        {{ form_row(form.save) }}
    {{ form_end(form) }}

    <a href="{{ path('library_book_list') }}">Avbryt och gå tillbaka</a>
{% endblock %}
