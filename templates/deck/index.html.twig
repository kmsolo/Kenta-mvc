{% extends 'base.html.twig' %}

{% import 'deck/_card.html.twig' as cards_macro %}

{% block title %}Kortlek{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/deck.css') }}">
{% endblock %}

{% block body %}
<div class="deck-page">
    <h1>Kortlek ({{ remaining }} kort kvar)</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if lastDrawn %}
        <div class="last-drawn">
            <p class="last-drawn__label">Senast draget kort</p>
            {{ cards_macro.card(lastDrawn, 0) }}
        </div>
    {% endif %}

<div class="actions d-flex gap-2 mb-3">
    <a href="{{ path('card_deck_shuffle') }}" class="btn btn-primary">Blanda</a>
    <a href="{{ path('card_deck_draw') }}" class="btn btn-success">Dra ett kort</a>
    <a href="{{ path('card_deck_draw_number', {number: 5}) }}" class="btn btn-outline-secondary">Dra 5 kort</a>
</div>
    <div class="cards" style="--total: {{ cards|length }};">
        {% for card in cards %}
            {{ cards_macro.card(card, loop.index0) }}
        {% else %}
            <p>Kortleken är tom.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}