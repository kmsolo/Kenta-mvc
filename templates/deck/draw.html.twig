{% extends 'base.html.twig' %}

{% import 'deck/_card.html.twig' as cards_macro %}

{% block title %}Dra kort{% endblock %}

{% block body %}
<div class="deck-page">
    <h1>Kort som drogs ({{ remaining }} kvar i leken)</h1>

    <div class="cards" style="--total: {{ drawn|length }};">
        {% for card in drawn %}
            {{ cards_macro.card(card, loop.index0) }}
        {% else %}
            <p>Kortleken var tom, inga kort kunde dras.</p>
        {% endfor %}
    </div>

    <p><a href="{{ path('card_deck_index') }}">Tillbaka till kortleken</a></p>
</div>
{% endblock %}
