<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Kortlek{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}

    {{ importmap('app') }}

    <style>
        body { padding-top: 4.5rem; }
        img { max-width: 10%; border-radius: 8px; }
        footer { margin-top: 3rem; padding: 1.5rem 0; color: #6c757d; }
    </style>
    <link rel="icon" href="{{ asset('favicon.ico') }}">
</head><body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Min me-sida</a>
            <div class="navbar-nav">
                <a class="nav-link" href="{{ path('app_home') }}">Hem</a>
                <a class="nav-link" href="{{ path('app_about') }}">Om kursen</a>
                <a class="nav-link" href="{{ path('app_report') }}">Redovisning</a>
                <a class="nav-link" href="{{ path('card_deck_index') }}">Kortlek</a>
                <a class="nav-link" href="{{ path('app_api_index') }}">Utforska JSON API</a>


            </div>
        </div>
    </nav>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

<footer class="container text-center">
    <strong>
        <small>Byggt med Symfony &amp; Bootstrap &mdash; dbwebb mvc-kursen</small>
        <small>&copy; Kenta 2026</small>
    </strong>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>