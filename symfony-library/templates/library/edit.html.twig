{% extends 'base.html.twig' %}

{% block title %}Uppdatera {{ book.title }}{% endblock %}

{% block body %}
    <h1>Uppdatera bok</h1>

    <img src="{{ book.coverImageUrl }}" alt="Omslag för {{ book.title }}" style="height: 100px;" class="mb-3 rounded">

    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.author) }}
        {{ form_row(form.isbn) }}
        {{ form_row(form.description) }}
        {{ form_row(form.save) }}
    {{ form_end(form) }}

    <a href="{{ path('library_book_show', {id: book.id}) }}">Avbryt och gå tillbaka</a>
{% endblock %}
